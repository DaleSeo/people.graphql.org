---
import styles from "./Layout.module.css";
import "../styles/global.css";
import Brand from "../components/Brand.astro";
interface Props {
  title?: string;
  description?: string;
  dark?: boolean;
}
const {
  title = "People of GraphQL",
  description = "The people, ideas, and stories behind GraphQL.",
  dark = false,
} = Astro.props;
const path = Astro.url.pathname;
const navigation = [
  { label: "Everyone", href: "/" },
  { label: "Stories", href: "/stories/" },
  { label: "Stars", href: "/stars/" },
  { label: "Working groups", href: "/wg/" },
  { label: "Ambassadors", href: "/ambassadors/" },
  { label: "Speakers", href: "/speakers/" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link
      rel="preload"
      href="/fonts/host-grotesk.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body data-theme={dark ? "dark" : undefined}>
    <a class={styles.skip} href="#main">
      Skip to content
    </a>
    <header class={styles.siteHeader}>
      <nav class={styles.navigation} aria-label="Main navigation">
        {navigation.map((item) => (
          <a
            href={item.href}
            data-directory-link
            aria-current={
              (item.href === "/" ? path === "/" : path.startsWith(item.href))
                ? "page"
                : undefined
            }
          >
            {item.label}
          </a>
        ))}
      </nav>
      <Brand />
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class={styles.footer}>
      <Brand />
      <span>A GraphQL Foundation project.</span>
      <a href="/about/">About this project</a>
    </footer>
  </body>
</html>
