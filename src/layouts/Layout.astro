---
import '../styles/global.css';
import Brand from '../components/Brand.astro';
interface Props { title?: string; description?: string; dark?: boolean }
const { title = 'People of GraphQL', description = 'The people, ideas, and stories behind GraphQL.', dark = false } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><title>{title}</title><link rel="preload" href="/fonts/host-grotesk.woff2" as="font" type="font/woff2" crossorigin /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /></head>
<body class:list={[{ dark }]}><a class="skip" href="#main">Skip to content</a>
<header class="site-header"><Brand /><nav aria-label="Main navigation"><a href="/stories/" aria-current={path.startsWith('/stories') ? 'page' : undefined}>Stories</a><a href="/stars/" aria-current={path.startsWith('/stars') ? 'page' : undefined}>GraphQL Stars <span aria-hidden="true">↗</span></a><a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a></nav></header>
<main id="main"><slot /></main><footer><Brand /><span>A community is made of people.</span><a href="/about/">About this project ↗</a></footer></body></html>
