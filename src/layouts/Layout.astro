---
import '../styles/global.css';
interface Props { title?: string; description?: string; dark?: boolean }
const { title = 'People of GraphQL', description = 'The people, ideas, and stories behind GraphQL.', dark = false } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><title>{title}</title><link rel="icon" href="/favicon.svg" type="image/svg+xml" /></head>
<body class:list={[{ dark }]}><a class="skip" href="#main">Skip to content</a>
<header class="site-header"><a class="brand" href="/" aria-label="People of GraphQL home"><span class="brand-icon" aria-hidden="true">✳</span><span>People of <b>GraphQL</b></span></a><nav aria-label="Main navigation"><a href="/stories/" aria-current={path.startsWith('/stories') ? 'page' : undefined}>Stories</a><a href="/stars/" aria-current={path.startsWith('/stars') ? 'page' : undefined}>GraphQL Stars <span aria-hidden="true">↗</span></a><a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a></nav></header>
<main id="main"><slot /></main><footer><a class="brand" href="/">People of <b>GraphQL</b></a><span>A community is made of people.</span><a href="/about/">About this project ↗</a></footer></body></html>
