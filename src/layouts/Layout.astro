---
import styles from "./Layout.module.css";
import "../styles/global.css";
import themeScript from "../scripts/theme.js?raw";
import Brand from "../components/Brand.astro";
interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = "People of GraphQL",
  description = "The people, ideas, and stories behind GraphQL.",
  image,
} = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const fallbackImage = new URL("https://graphql.org/og/");
fallbackImage.search = new URLSearchParams({
  v: "3",
  path: Astro.url.pathname,
  title,
}).toString();
const socialImage = image ? new URL(image, Astro.site) : fallbackImage;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline set:html={themeScript} />
    <link
      rel="preload"
      href="/fonts/host-grotesk.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class={styles.skip} href="#main">
      Skip to content
    </a>
    <header class={styles.siteHeader}>
      <div class={styles.topBar}>
        <Brand />
        <nav class={styles.aboutLinks} aria-label="About the projects">
          <a href="/stars/about/">About Stars</a>
          <a href="/stories/about/">About Stories</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <script>
      import "../scripts/external-links";
    </script>
    <footer class={styles.footer}>
      <button
        type="button"
        class={styles.themeToggle}
        data-theme-toggle
        aria-label="Switch color theme"
      >
        <span class={styles.lightLabel}>
          <svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
          </svg>
          Light
        </span>
        <span class={styles.darkLabel}>
          <svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path d="M20.5 14a9 9 0 0 1-10.5-10.5A9 9 0 1 0 20.5 14Z" />
          </svg>
          Dark
        </span>
      </button>
      <a
        class={styles.foundationLink}
        href="https://graphql.org/"
        target="_blank"
        rel="noopener noreferrer"
      >
        A GraphQL Foundation project
      </a>
      <span>Copyright © 2026 The GraphQL Foundation. All rights reserved.</span>
    </footer>
  </body>
</html>
