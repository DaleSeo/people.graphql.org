---
import Layout from '../layouts/Layout.astro';
import StarsConstellation from '../components/StarsConstellation.astro';
import { getCollection } from 'astro:content';
const stories = (await getCollection('stories')).sort((a,b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime() || a.id.localeCompare(b.id));
const [featured, ...rest] = stories;
---
<Layout>
  <section class="intro wrap">
    <h1>Code is only<br /><em>part of the story.</em></h1>
    <div class="intro-bottom">
      <p>Meet the maintainers, practitioners, educators, and organizers working across the GraphQL ecosystem.</p>
    </div>
    </section>
  <section class="wrap stories-section">
    <div class="section-label">
      <a href="/stories/">Explore all stories</a>
    </div>
    <a class="featured" href={`/stories/${featured.id}/`}>
      <div class="portrait feature-art" style={`--portrait:${featured.data.color}`}>
        <span class="portrait-initials">{featured.data.initials}</span>
        <span class="image-caption">PEOPLE OF GRAPHQL · STORY PREVIEW</span>
      </div>
      <div class="feature-copy">
        <h2>{featured.data.title}</h2>
        <p>{featured.data.description}</p>
        <div class="story-credit"><span>{featured.data.name}</span></div>
      </div>
    </a>
    <div class="story-grid">{rest.map(story =>
      <a class="story-card" href={`/stories/${story.id}/`}>
        <div class="portrait card-art" style={`--portrait:${story.data.color}`}>
          <span class="portrait-initials">{story.data.initials}</span>
          <span class="image-caption">STORY PREVIEW</span>
        </div>
        <h3>{story.data.title}</h3>
        <p>{story.data.description}</p>
        <div class="card-credit">{story.data.name}<span>Read the preview</span></div>
      </a>)}
    </div>
  </section>
  <section class="stars-teaser">
    <div class="wrap teaser-inner">
      <div>
        <h2>A constellation<br />of contributions.</h2>
        <p>Each year, GraphQL Stars recognizes 52 people for their<br class="desktop" />contributions across the GraphQL GitHub repositories.</p>
        <a class="button" href="/stars/">Explore the class of 2026</a>
      </div>
      <StarsConstellation />
    </div>
  </section>
</Layout>
