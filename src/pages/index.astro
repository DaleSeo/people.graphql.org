---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const stories = (await getCollection('stories')).sort((a,b) => a.data.order-b.data.order);
const [featured, ...rest] = stories;
---
<Layout><section class="intro wrap"><p class="eyebrow"><span class="pink-dot"></span> THE HUMAN SIDE OF THE GRAPH</p><h1>Great technology.<br /><em>Even better people.</em></h1><div class="intro-bottom"><p>Behind every query, there’s a person.<br />Meet the people making GraphQL what it is.</p><span class="small-note">Ideas. Journeys. Connections.</span></div></section>
<section class="wrap stories-section"><div class="section-label"><h2>The stories</h2><a href="/stories/">Explore all stories ↗</a></div>
<a class="featured" href={`/stories/${featured.id}/`}><div class="portrait feature-art" style={`--portrait:${featured.data.color}`}><span class="art-orbit orbit-one"></span><span class="art-orbit orbit-two"></span><span class="portrait-initials">{featured.data.initials}</span><span class="image-caption">PEOPLE OF GRAPHQL · STORY PREVIEW</span></div><div class="feature-copy"><p class="eyebrow">01 / {featured.data.category}</p><h2>{featured.data.title}</h2><p>{featured.data.description}</p><div class="story-credit"><span>{featured.data.name}<small>Sample story · 3 min read</small></span><span class="round-arrow">↗</span></div></div></a>
<div class="story-grid">{rest.map(story => <a class="story-card" href={`/stories/${story.id}/`}><div class="portrait card-art" style={`--portrait:${story.data.color}`}><span class="art-orbit"></span><span class="portrait-initials">{story.data.initials}</span><span class="image-caption">STORY PREVIEW</span></div><p class="eyebrow">{story.data.category}</p><h3>{story.data.title}</h3><p>{story.data.description}</p><div class="card-credit">{story.data.name}<span>Read the preview ↗</span></div></a>)}</div></section>
<section class="stars-teaser"><div class="wrap teaser-inner"><div><p class="eyebrow">MANY CONTRIBUTORS. ONE COMMUNITY.</p><h2>A constellation<br />of contributions.</h2><p>52 GraphQL Stars. An annual celebration of the people<br class="desktop" /> moving the ecosystem forward.</p><a class="button" href="/stars/">Meet the GraphQL Stars <span>↗</span></a></div><div class="star-illustration" aria-hidden="true"><span>52</span><small>PEOPLE. COUNTLESS POSSIBILITIES.</small></div></div></section>
<section class="wrap closing"><p class="eyebrow">OPEN SOURCE. HUMAN STORIES.</p><h2>The graph connects our data.<br /><em>The people connect us.</em></h2><a href="/about/">A little about this project ↗</a></section></Layout>
