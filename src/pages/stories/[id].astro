---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { return (await getCollection('stories')).map(story => ({ params: { id: story.id }, props: { story } })); }
const { story } = Astro.props;
const { Content } = await render(story);
---
<Layout title={`${story.data.title} · People of GraphQL`} description={story.data.description}><article class="wrap article"><a class="back" href="/stories/">← All stories</a><header class="article-header"><p class="eyebrow">{story.data.category}</p><h1>{story.data.title}</h1><p class="standfirst">{story.data.description}</p><p>{story.data.name} <span class="muted"> / Editorial preview</span></p></header><div class="portrait article-art" style={`--portrait:${story.data.color}`}><span class="art-orbit"></span><span class="portrait-initials">{story.data.initials}</span></div><div class="article-body">{story.data.sample && <p class="notice">This is sample editorial content with a fictional subject, not a published interview.</p>}<Content /><a class="back" href="/stories/">Explore more stories</a></div></article></Layout>
