---
import shared from '../../styles/shared.module.css';
import cards from '../../styles/storyCards.module.css';
import styles from './index.module.css';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const stories = (await getCollection('stories')).sort((a,b)=>b.data.publishedAt.getTime() - a.data.publishedAt.getTime() || a.id.localeCompare(b.id));
---
<Layout title="Stories · People of GraphQL"><section class:list={[shared.wrap, shared.pageIntro]}><p class={shared.eyebrow}>PEOPLE OF GRAPHQL / STORIES</p><h1>Behind the code.<br /><em>In their own words.</em></h1><p>Personal journeys from across the GraphQL community.</p><p class={shared.notice}>Editorial previews — sample names and copy, ready for your interviews.</p></section><section class:list={[shared.wrap, cards.storyGrid, styles.archive]} aria-label="Stories">{stories.map(story => <a class={cards.storyCard} href={`/stories/${story.id}/`}><div class:list={[cards.portrait, cards.cardArt]} style={`--portrait:${story.data.color}`}><span class={cards.portraitInitials}>{story.data.initials}</span></div><p class={shared.eyebrow}><time datetime={story.data.publishedAt.toISOString().slice(0, 10)}>{story.data.publishedAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></p><h2>{story.data.title}</h2><p>{story.data.description}</p><div class={cards.cardCredit}>{story.data.name}<span>Read preview</span></div></a>)}</section></Layout>
