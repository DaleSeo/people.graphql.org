---
import shared from "../../styles/shared.module.css";
import styles from "./index.module.css";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
const stories = (await getCollection("stories")).sort(
  (a, b) =>
    b.data.publishedAt.getTime() - a.data.publishedAt.getTime() ||
    a.id.localeCompare(b.id),
);
const avatars = new Set(
  Object.keys(import.meta.glob("/public/avatars/*.png")).map((path) =>
    path.replace("/public", ""),
  ),
);
---

<Layout title="Stories · People of GraphQL">
  <section class:list={[shared.wrap, shared.pageIntro]}>
    <p class={shared.eyebrow}>PEOPLE OF GRAPHQL / STORIES</p>
    <h1>
      Behind the code.
      <br />
      <em>In their own words.</em>
    </h1>
    <p>Personal journeys from across the GraphQL community.</p>
  </section>
  <section class:list={[shared.wrap, styles.archive]} aria-label="Stories">
    <div class={styles.storyList}>
      {stories.map((story) => {
        const avatar = `/avatars/${story.data.github}.png`;
        const initials = story.data.name
          .split(/\s+/)
          .map((part) => part[0])
          .slice(0, 2)
          .join("");
        return (
          <article class={styles.storyRow}>
            {story.data.hero && (
              <a
                class={styles.hero}
                href={`/stories/${story.id}/`}
                tabindex="-1"
                aria-hidden="true"
              >
                <img
                  src={story.data.hero.src}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </a>
            )}
            <div class={styles.storyCopy}>
              <p class={shared.eyebrow}>
                <time
                  datetime={story.data.publishedAt.toISOString().slice(0, 10)}
                >
                  {story.data.publishedAt.toLocaleDateString("en-GB", {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                    timeZone: "UTC",
                  })}
                </time>
              </p>
              <h2>
                <a href={`/stories/${story.id}/`}>{story.data.title}</a>
              </h2>
              <p class={styles.description}>{story.data.description}</p>
              <div class={styles.person}>
                <div class={styles.avatar} aria-hidden="true">
                  <span>{initials}</span>
                  {story.data.github && avatars.has(avatar) && (
                    <img
                      src={avatar}
                      alt=""
                      width="240"
                      height="240"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </div>
                <div>
                  <p class={styles.personName}>{story.data.name}</p>
                  {story.data.github && (
                    <p class={styles.username}>@{story.data.github}</p>
                  )}
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</Layout>
<script>
  import styles from "./index.module.css";
  for (const avatar of document.querySelectorAll<HTMLImageElement>(
    `.${styles.avatar} img`,
  )) {
    const showFallback = () => {
      avatar.hidden = true;
    };
    avatar.addEventListener("error", showFallback);
    if (avatar.complete && avatar.naturalWidth === 0) showFallback();
  }
</script>
