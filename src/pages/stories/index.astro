---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const stories = (await getCollection('stories')).sort((a,b)=>b.data.publishedAt.getTime() - a.data.publishedAt.getTime() || a.id.localeCompare(b.id));
---
<Layout title="Stories · People of GraphQL"><section class="wrap page-intro"><p class="eyebrow">PEOPLE OF GRAPHQL / STORIES</p><h1>Behind the code.<br /><em>In their own words.</em></h1><p>Personal journeys from across the GraphQL community.</p><p class="notice">Editorial previews — sample names and copy, ready for your interviews.</p></section><section class="wrap story-grid archive" aria-label="Stories">{stories.map(story => <a class="story-card" href={`/stories/${story.id}/`}><div class="portrait card-art" style={`--portrait:${story.data.color}`}><span class="art-orbit"></span><span class="portrait-initials">{story.data.initials}</span></div><p class="eyebrow"><time datetime={story.data.publishedAt.toISOString().slice(0, 10)}>{story.data.publishedAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></p><h2>{story.data.title}</h2><p>{story.data.description}</p><div class="card-credit">{story.data.name}<span>Read preview</span></div></a>)}</section></Layout>
