---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const stars = (await getCollection('stars')).sort((a,b)=>a.data.name.localeCompare(b.data.name));
const years = [...new Set(stars.map(s=>s.data.year))].sort((a,b)=>b-a);
---
<Layout title="GraphQL Stars · People of GraphQL" dark><section class="wrap page-intro stars-intro"><p class="eyebrow">THE PEOPLE WHO MOVE US FORWARD</p><h1>Small contributions.<br /><em>Brilliant impact.</em><span class="inline-star" aria-hidden="true">✳</span></h1><div class="intro-bottom"><p>Meet the GraphQL Stars. A celebration of 52 people<br />shaping the future of our community, every year.</p><label class="year-label">Class of <select id="year" aria-label="Choose a year">{years.map(year=><option value={year}>{year}</option>)}</select></label></div></section><section class="wrap gallery-section"><div class="gallery-toolbar"><p><span id="count">{stars.filter(s=>s.data.year===years[0]).length}</span> people to discover</p><label class="search-label"><span class="sr-only">Search contributors</span><input id="search" type="search" placeholder="Find a person or contribution…" /></label></div><p class="notice">Sample gallery — these fictional profiles demonstrate the layout. The confirmed 52 Stars will go here.</p><div class="stars-grid">{stars.map(star => <details class="star-card" data-year={star.data.year} data-search={`${star.data.name} ${star.data.contribution}`.toLowerCase()} hidden={star.data.year!==years[0]}><summary><div class="avatar" style={`--portrait:${star.data.color}`}>{star.data.avatar ? <img src={star.data.avatar} alt="" loading="lazy" width="300" height="300" /> : <span>{star.data.initials}</span>}<span class="avatar-plus" aria-hidden="true">+</span></div><h2>{star.data.name}</h2><p>{star.data.sample ? 'Sample profile' : 'GraphQL Star'} <span aria-hidden="true">↗</span></p></summary><div class="star-bio"><p>{star.data.contribution}</p>{star.data.github && <a href={`https://github.com/${star.data.github}`}>@{star.data.github} ↗</a>}</div></details>)}</div><p id="empty" hidden>No people match your search. Try a different name or contribution.</p><p class="gallery-end">Every contribution has a person behind it. <span aria-hidden="true">✳</span></p></section></Layout>
<script>
const search = document.querySelector<HTMLInputElement>('#search')!;
const year = document.querySelector<HTMLSelectElement>('#year')!;
const cards = [...document.querySelectorAll<HTMLDetailsElement>('.star-card')];
function filter() {
  let count = 0;
  for (const card of cards) {
    card.hidden = card.dataset.year !== year.value || !card.dataset.search?.includes(search.value.trim().toLowerCase());
    if (!card.hidden) count++; else card.open = false;
  }
  document.querySelector('#count')!.textContent = String(count);
  document.querySelector<HTMLElement>('#empty')!.hidden = count > 0;
}
search.addEventListener('input', filter);
year.addEventListener('change', filter);
for (const card of cards) card.addEventListener('toggle', () => {
  if (card.open) for (const other of cards) if (other !== card) other.open = false;
});
</script>
