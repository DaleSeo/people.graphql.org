---
import { getCollection } from "astro:content";
import StarsClass from "../../components/StarsClass.astro";

export async function getStaticPaths() {
  const stars = await getCollection("stars");
  const years = [...new Set(stars.map((star) => star.data.year))].sort(
    (a, b) => b - a,
  );
  return years.map((year) => ({
    params: { year: String(year) },
    props: {
      year,
      years,
      stars: stars.filter((star) => star.data.year === year),
    },
  }));
}

const { year, years, stars } = Astro.props;
---

<StarsClass year={year} years={years} stars={stars} />
