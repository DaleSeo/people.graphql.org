---
import shared from '../../styles/shared.module.css';
import styles from './index.module.css';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
// Discover filenames at build time without loading image contents into the page.
const contributionImages = new Set(
  Object.keys(import.meta.glob('/public/stars/*/*.png', { query: '?url', import: 'default' }))
    .map(path => path.replace('/public', ''))
);
const stars = (await getCollection('stars'))
  .sort((a,b)=>a.data.name.localeCompare(b.data.name))
  .map(star => {
    const imagePath = `/stars/${star.data.year}/${star.data.github}.png`;
    return { ...star, contributionImage: star.data.github && contributionImages.has(imagePath) ? imagePath : undefined };
  });
const years = [...new Set(stars.map(s=>s.data.year))].sort((a,b)=>b-a);
---
<Layout title="GraphQL Stars" dark>
  <section class:list={[shared.wrap, shared.pageIntro, styles.starsIntro]}>
    <p class={shared.eyebrow}>GRAPHQL STARS</p>
    <h1>A universe shaped<br /><em>by contributors.</em></h1>
    <div class={shared.introBottom}>
      <p>GraphQL Stars celebrates 52 people each year<br />whose work across the GraphQL GitHub repositories moves the project forward.</p>
      <label class={styles.yearLabel}>Class of <select id="year" aria-label="Choose a year">{years.map(year=><option value={year}>{year}</option>)}</select></label>
    </div>
    <a class={styles.starsAboutLink} href="/stars/about/">About GraphQL Stars</a>
  </section>
  <section class:list={[shared.wrap, styles.gallerySection]}>
    <div class={styles.galleryToolbar}>
      <p><span id="count">{stars.filter(s=>s.data.year===years[0]).length}</span> people to discover</p>
      <label class={styles.searchLabel}><span class={shared.srOnly}>Search contributors</span><input id="search" type="search" placeholder="Find a name or GitHub username…" /></label>
    </div>
    <div class={styles.starsGrid}>{stars.map(star =>
      <div class={styles.starCard} data-year={star.data.year} data-search={`${star.data.name} ${star.data.github ?? ''}`.toLowerCase()} hidden={star.data.year!==years[0]}>
        <button class={styles.starTrigger} type="button" aria-haspopup="dialog" aria-label={`View ${star.data.name}, class of ${star.data.year}`}>
         <div class:list={[styles.avatar, { [styles.tsc]: star.data.tsc }]}><span class={styles.avatarFallback} aria-hidden="true">{star.data.initials}</span>{star.data.avatar && <img src={star.data.avatar} alt="" loading="lazy" decoding="async" width="240" height="240" />}</div>
       </button>
       <template>
          <div class={styles.starDialogProfile}>
            <p class={shared.eyebrow}>GRAPHQL STARS · {star.data.year}</p>
            <h2 id="star-dialog-name">{star.data.name}</h2>

            {star.data.tsc && (
              <p class={styles.tscLabel}>
                Technical Steering Committee · {star.data.year}
              </p>
            )}

            {star.data.github && (
              <a
                href={`https://github.com/${star.data.github}`}
                set:text={`@${star.data.github} ↗`}
              />
            )}
          </div>
          {star.contributionImage && (
            <figure class={styles.starContribution}>
              <button class={styles.starCardZoom} type="button" aria-label="Zoom contribution card" aria-pressed="false" title="Click to zoom in">
              <img
                src={star.contributionImage}
                alt={`GraphQL contributions for ${star.data.name}, class of ${star.data.year}`}
                decoding="async"
              />
              </button>
            </figure>
          )}
        </template>
      </div>)}
    </div>
    <p id="empty" hidden>No people match your search. Try another name or username.</p>
  </section>
  <dialog class={styles.starDialog} aria-labelledby="star-dialog-name">
    <button class={styles.starDialogClose} type="button" aria-label="Close profile" autofocus>×</button>
    <div class={styles.starDialogContent}></div>
  </dialog>
</Layout>
<script>
import styles from './index.module.css';
for (const avatar of document.querySelectorAll<HTMLImageElement>(`.${styles.avatar} img`)) {
  const showFallback = () => { avatar.hidden = true; };
  avatar.addEventListener('error', showFallback);
  if (avatar.complete && avatar.naturalWidth === 0) showFallback();
}
const search = document.querySelector<HTMLInputElement>('#search')!;
const year = document.querySelector<HTMLSelectElement>('#year')!;
const cards = [...document.querySelectorAll<HTMLDivElement>(`.${styles.starCard}`)];
// Fisher–Yates runs in the browser so each page load gets a fresh order.
for (let i = cards.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [cards[i], cards[j]] = [cards[j], cards[i]];
}
const gallery = document.querySelector<HTMLElement>(`.${styles.starsGrid}`)!;
gallery.append(...cards);

function filter() {
  let count = 0;
  for (const card of cards) {
    card.hidden = card.dataset.year !== year.value || !card.dataset.search?.includes(search.value.trim().toLowerCase());
    if (!card.hidden) count++;
  }
  document.querySelector('#count')!.textContent = String(count);
  document.querySelector<HTMLElement>('#empty')!.hidden = count > 0;
}
search.addEventListener('input', filter);
year.addEventListener('change', filter);
const dialog = document.querySelector<HTMLDialogElement>(`.${styles.starDialog}`)!;
const content = dialog.querySelector<HTMLElement>(`.${styles.starDialogContent}`)!;
content.addEventListener('click', event => {
  const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>(`.${styles.starCardZoom}`) : null;
  if (!button) return;
  const zoomed = button.getAttribute('aria-pressed') !== 'true';
  button.setAttribute('aria-pressed', String(zoomed));
  button.title = zoomed ? 'Click to zoom out' : 'Click to zoom in';
  const figure = button.closest<HTMLElement>(`.${styles.starContribution}`)!;
  figure.classList.toggle(styles.isZoomed, zoomed);
  if (!zoomed) figure.scrollTo(0, 0);
});
for (const card of cards) {
  card.querySelector<HTMLButtonElement>(`.${styles.starTrigger}`)!.addEventListener('click', () => {
    content.replaceChildren(card.querySelector('template')!.content.cloneNode(true));
    dialog.showModal();
  });
}
dialog.querySelector('button')!.addEventListener('click', () => dialog.close());
dialog.addEventListener('click', event => {
  const bounds = dialog.getBoundingClientRect();
  if (event.target === dialog && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) dialog.close();
});
dialog.addEventListener('close', () => content.replaceChildren());
</script>
