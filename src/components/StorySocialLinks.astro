---
import SocialLink from "./SocialLink.astro";
import { socialIcons } from "../lib/social-links";
interface Props {
  links: { label: string; url: string; username?: string }[];
}
const { links } = Astro.props;
---

<ul>
  {links.map((link) => (
    <li>
      <SocialLink
        url={link.url}
        label={link.label}
        text={link.username ?? link.label}
        icon={socialIcons[link.label.toLowerCase()]}
      />
    </li>
  ))}
</ul>
