---
const people = [
  { github: 'acao', extension: 'jpg', x: 20, y: 20 },
  { github: 'martinbonnin', extension: 'jpg', x: 50, y: 20 },
  { github: 'keweiqu', extension: 'jpg', x: 80, y: 20 },
  { github: 'sachindshinde', extension: 'jpg', x: 35, y: 50 },
  { github: 'sarahxsanders', extension: 'png', x: 65, y: 50 },
  { github: 'enisdenjo', extension: 'png', x: 20, y: 80 },
  { github: 'michaelstaib', extension: 'jpg', x: 50, y: 80 },
  { github: 'hasparus', extension: 'jpg', x: 80, y: 80 },
];
---
<div class="stars-constellation" aria-hidden="true">
  <span class="constellation-dot" style="--x:8%;--y:43%;--dot-size:5px"></span>
  <span class="constellation-dot" style="--x:92%;--y:58%;--dot-size:6px"></span>
  <span class="constellation-dot" style="--x:36%;--y:7%;--dot-size:4px"></span>
  <span class="constellation-dot" style="--x:65%;--y:94%;--dot-size:4px"></span>
  <span class="constellation-dot" style="--x:50%;--y:50%;--dot-size:3px"></span>
  {people.map(person => (
    <img
      class="constellation-avatar"
      src={`/avatars/${person.github}.${person.extension}`}
      alt=""
      width="200"
      height="200"
      loading="lazy"
      decoding="async"
      style={`--x:${person.x}%;--y:${person.y}%`}
    />
  ))}
</div>
