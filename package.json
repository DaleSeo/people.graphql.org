{
  "name": "people-of-graphql",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-people.mjs && astro dev --force",
    "build": "node scripts/sync-people.mjs && astro build",
    "preview": "astro preview",
